{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the TMP Companion window. App commands are granted one by one (allow-<command>), exactly the ones src/lib/invoke.ts calls; every other registered command is denied to the webview. src-tauri/src/command_surface_tests.rs keeps this list, invoke.ts and app_commands.rs in step.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "updater:default",
    "process:default",
    "allow-add-setlist",
    "allow-add-setlist-songs",
    "allow-app-info",
    "allow-build-support-bundle",
    "allow-calibrate-profile",
    "allow-cancel-doctor-check",
    "allow-cancel-footswitch-leveling",
    "allow-cancel-preset-leveling",
    "allow-cancel-scene-leveling",
    "allow-connect-device",
    "allow-copy-apply",
    "allow-create-song-full",
    "allow-current-graph",
    "allow-doctor-apply",
    "allow-doctor-check",
    "allow-doctor-discard",
    "allow-doctor-save",
    "allow-get-store",
    "allow-level-footswitches-apply",
    "allow-level-preset",
    "allow-level-scenes-apply-batched",
    "allow-list-footswitch-scene-contexts",
    "allow-list-level-blocks",
    "allow-list-pickup-topologies",
    "allow-list-presets",
    "allow-list-scene-level-handles",
    "allow-list-setlist-songs",
    "allow-list-songs",
    "allow-move-setlist-song",
    "allow-read-active-preset",
    "allow-read-library-via-backup",
    "allow-read-setlists",
    "allow-remove-setlist",
    "allow-remove-setlist-song",
    "allow-remove-song",
    "allow-rename-setlist",
    "allow-save-profiles",
    "allow-save-support-bundle",
    "allow-save-targets",
    "allow-set-auto-install-updates",
    "allow-set-playback-level",
    "allow-update-song-full"
  ]
}
