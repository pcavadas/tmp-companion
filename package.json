{
  "name": "tmp-companion",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "USB controller for the Fender Tone Master Pro: loudness leveling, block copy, and song/setlist editing",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "bash scripts/tauri-dev-env.sh",
    "tauri:dev": "bash scripts/tauri-dev-env.sh dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bash scripts/e2e.sh",
    "lint": "eslint src/ e2e/ --max-warnings 0",
    "lint:fix": "eslint src/ e2e/ --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "screenshots": "cargo test --manifest-path src-tauri/Cargo.toml --lib build_showcase_fixture -- --ignored && playwright test -c e2e/showcase/playwright.showcase.config.ts",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'e2e/**/*.ts' '*.config.{js,ts}' .prettierrc index.html",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'e2e/**/*.ts' '*.config.{js,ts}' .prettierrc index.html",
    "leak-guard": "bash scripts/leak-guard.sh --all",
    "docs:check": "bash scripts/check-docs.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,e2e}/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{js,json,css,html}": "prettier --write"
  },
  "dependencies": {
    "@fontsource/inter": "~5.3.0",
    "@fontsource/jetbrains-mono": "~5.3.0",
    "@fontsource/source-serif-4": "~5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@semantic-release/exec": "^7.1.0",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
